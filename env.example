# Duma. Copia este archivo a `.env`, llénalo y déjalo en permisos 600.
# `.env` NO se versiona (ver .gitignore). Nunca pegues estos valores en un chat.

# ── Telegram ──────────────────────────────────────────────────────────
# SECRETO. Token del bot (BotFather).
TELEGRAM_BOT_TOKEN=
# Único grupo atendido. Los supergrupos tienen id negativo (-100...).
TELEGRAM_ADMIN_CHAT_ID=
# Ids de Telegram de los admins permitidos, separados por coma.
TELEGRAM_ALLOWED_USER_IDS=

# ── API de Muungano ───────────────────────────────────────────────────
# Siempre 127.0.0.1, no "localhost": "localhost" puede resolver a IPv6 y llegar a otro servidor (p. ej. el contenedor
# de Docker en el 8000). Local y producción: http://127.0.0.1:8000. API de pruebas del servidor: http://127.0.0.1:8001.
BOT_API_URL=http://127.0.0.1:8000
# SECRETO. El MISMO valor que ASSISTANT_TOKEN en el .env del API (mínimo 32 caracteres).
BOT_API_TOKEN=

# ── Anthropic ─────────────────────────────────────────────────────────
# SECRETO. Llave propia del bot, distinta de la que usa el API para leer comprobantes.
ANTHROPIC_API_KEY=
BOT_MODEL=claude-sonnet-5-5
BOT_ROUTER_MODEL=claude-sonnet-5-5

# ── Límites ───────────────────────────────────────────────────────────
BOT_MAX_TURNS=8
BOT_MAX_TOKENS_PER_MESSAGE=4000
BOT_DAILY_BUDGET_USD=5
BOT_SESSION_MAX_TOKENS=100000
# Horas sin mensajes tras las que Duma cierra un tema y borra su conversación. 0 = nunca.
BOT_SESSION_IDLE_HOURS=24
BOT_CONFIRM_TTL_MIN=15
# Segundos que espera Duma antes de ejecutar lo que se pulsó, con un botón Cancelar. 0 = de inmediato.
BOT_ACTION_DELAY_S=10
# Puerto en 127.0.0.1 donde el API le avisa a Duma de una solicitud nueva. 0 = no escucha.
BOT_HOOK_PORT=8765
BOT_API_TIMEOUT_S=30
BOT_API_MAX_PER_MIN=60
# Mensajes más viejos que esto al leerlos (Duma estaba apagado) se saltan.
BOT_STALE_AFTER_S=300

# ── Estado ────────────────────────────────────────────────────────────
# PostgreSQL donde Duma guarda sesiones y confirmaciones, en un esquema propio. Vacía: usa CLOUDRON_POSTGRESQL_URL
# (en producción no hay que poner nada); sin ninguna de las dos, archivo SQLite en BOT_STATE_DIR.
# Local: postgresql://duma:local@localhost:5434/muungano
BOT_DATABASE_URL=
BOT_DATABASE_SCHEMA=duma
BOT_STATE_DIR=./state
BOT_TZ=America/Monterrey

# ── Notas de voz ──────────────────────────────────────────────────────
# Se transcriben en este servidor con Whisper; el audio no sale. Requiere `pip install -e '.[voice]'`.
# El modelo (463 MB para small) se descarga al arrancar a BOT_VOICE_DIR (por defecto, BOT_STATE_DIR/whisper).
BOT_VOICE_MODEL=small
BOT_VOICE_THREADS=2
BOT_VOICE_MAX_S=120
# BOT_VOICE_DIR=
